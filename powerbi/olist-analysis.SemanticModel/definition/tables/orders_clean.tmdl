table orders_clean
	lineageTag: 95e3c346-e499-4322-a5ff-4fbe54cc1267

	measure 'On-Time Delivery %' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(orders_clean),
			        orders_clean[is_delivered] = TRUE,
			        orders_clean[delivery_delay_days] <= 0
			    ),
			    CALCULATE(COUNTROWS(orders_clean), orders_clean[is_delivered] = TRUE)
			)*100
		formatString: 0.#\%
		lineageTag: 172ebdf1-d27f-4af1-8654-dbef703f7ec8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Delivery %' =
			DIVIDE(
			    CALCULATE(COUNTROWS(orders_clean), orders_clean[delivery_delay_days] > 0),
			    CALCULATE(COUNTROWS(orders_clean), orders_clean[is_delivered] = TRUE)
			)*100
		formatString: 0.#\%
		lineageTag: 3f6a2c1d-8e4b-4a97-9c25-7d1e0b5a4f88

	column order_id
		dataType: string
		lineageTag: d9d3845f-1ec9-4b8a-9889-d448f8249b63
