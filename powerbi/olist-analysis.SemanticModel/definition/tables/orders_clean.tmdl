	column is_delivered
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 6e988f40-8c28-4b5d-a334-292897a0354b
		summarizeBy: none
		sourceColumn: is_delivered

		annotation SummarizationSetBy = Automatic

	column delivery_delay_days
		dataType: int64
		formatString: 0
		lineageTag: 840f4fdf-5b43-4116-8a1a-e41c5092d7d9
		summarizeBy: sum
		sourceColumn: delivery_delay_days

		annotation SummarizationSetBy = Automatic

	column 'Delivery Delay Bucket' = SWITCH(TRUE(), orders_clean[is_delivered] = FALSE(), "Not delivered", orders_clean[delivery_delay_days] <= -7, "Early (7+ days)", orders_clean[delivery_delay_days] <= 0, "On time", orders_clean[delivery_delay_days] <= 7, "Late 1-7 days", orders_clean[delivery_delay_days] <= 14, "Late 8-14 days", "Late 15+ days")
		dataType: string
		lineageTag: 9d4c1a72-6b85-4e39-b0f2-8c7d3e5a1b64
		summarizeBy: none
		sortByColumn: 'Delivery Delay Bucket Order'

	column 'Delivery Delay Bucket Order' = SWITCH(TRUE(), orders_clean[is_delivered] = FALSE(), 6, orders_clean[delivery_delay_days] <= -7, 1, orders_clean[delivery_delay_days] <= 0, 2, orders_clean[delivery_delay_days] <= 7, 3, orders_clean[delivery_delay_days] <= 14, 4, 5)
		dataType: int64
		formatString: 0
		lineageTag: 1a7f3b90-4e62-4c58-9d31-6b2a8f0e5c77
		summarizeBy: none

	column 'Delivery Status' = SWITCH(TRUE(), orders_clean[is_delivered] = FALSE(), "Not delivered", orders_clean[delivery_delay_days] <= 0, "On time", "Late delivery")
		dataType: string
		lineageTag: ca922a1b-ba28-4b85-bf0c-e7112027f154
		summarizeBy: none

	partition orders_clean = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Shashwat Trigunayat\OneDrive\Desktop\Admin\DA\olist-analysis\data\cleaned\orders_clean.csv"),[Delimiter=",", Columns=10, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"order_id", type text}, {"customer_id", type text}, {"order_status", type text}, {"order_purchase_timestamp", type datetime}, {"order_approved_at", type datetime}, {"order_delivered_carrier_date", type datetime}, {"order_delivered_customer_date", type datetime}, {"order_estimated_delivery_date", type date}, {"is_delivered", type logical}, {"delivery_delay_days", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

