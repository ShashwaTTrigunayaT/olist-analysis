table order_reviews_clean
	lineageTag: 579cacf6-ab25-4721-a8c6-7378c7781bcf

	measure 'Avg Review Score' = AVERAGE(order_reviews_clean[review_score])
		formatString: 0.00
		lineageTag: 6c1d8e3f-2a74-4b90-8e15-9f3c7a2b6d41

	measure 'Total Reviews' = COUNTROWS(order_reviews_clean)
		formatString: 0
		lineageTag: 8a5b2c7e-1f93-4d68-b7a0-3e6c9d4f2b15

	measure 'On-Time Avg Review Score' = CALCULATE([Avg Review Score], orders_clean[Delivery Status] = "On time")
		formatString: 0.00
		lineageTag: b67f37c8-b52a-478b-a9c6-6ef62faaf12e

	measure 'Late Avg Review Score' = CALCULATE([Avg Review Score], orders_clean[Delivery Status] = "Late delivery")
		formatString: 0.00
		lineageTag: 1422a39c-1ad0-48d7-8719-cf418f9110e1

	measure 'Score Gap' = [On-Time Avg Review Score] - [Late Avg Review Score]
		formatString: 0.00
		lineageTag: 94dae6f5-c5dc-4c4c-b5bc-8a138a5d1208

	column review_id
		dataType: string
		lineageTag: d57222b5-7155-484c-b641-e2dd22b86d03
		summarizeBy: none
		sourceColumn: review_id

		annotation SummarizationSetBy = Automatic

	column order_id
		dataType: string
		lineageTag: a5dcba12-74fe-4d80-82fd-184430f618c3
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

	column review_score
		dataType: int64
		formatString: 0
		lineageTag: 6e7a78bf-7dfd-45e2-a304-22645aea86d0
		summarizeBy: sum
		sourceColumn: review_score

		annotation SummarizationSetBy = Automatic

