table order_items_clean
	lineageTag: 66f95cf2-48a8-463c-a23f-9dc6e6a53128

	measure 'Total Sales' = SUM(order_items_clean[price])
		formatString: R$ #,0.00
		lineageTag: a9d3962d-a102-4dfa-8297-ae48369978ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' = DISTINCTCOUNT(order_items_clean[order_id])
		formatString: 0
		lineageTag: 821d6a59-d8da-47f1-ba70-6fae77ebb7a7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Freight' = SUM(order_items_clean[freight_value])
		formatString: R$ #,0.00
		lineageTag: 31aea660-8266-495c-ba90-7e19abd74975

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Order Value' = DIVIDE([Total Sales], [Total Orders])
		formatString: R$ #,0.00
		lineageTag: 054d087d-6e08-4a39-a310-7e06048c8f09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Change Pct' =
			VAR endDate  = MAX(orders_clean[order_purchase_timestamp])
			VAR backOff  = EDATE(endDate, -11)
			VAR curStart = DATE(YEAR(backOff), MONTH(backOff), 1)
			VAR prevEnd  = curStart - 1
			VAR backPre  = EDATE(prevEnd, -11)
			VAR prevStart = DATE(YEAR(backPre), MONTH(backPre), 1)
			VAR cur  = CALCULATE([Total Sales], DateTable[Date] >= curStart, DateTable[Date] <= endDate)
			VAR prev = CALCULATE([Total Sales], DateTable[Date] >= prevStart, DateTable[Date] <= prevEnd)
			RETURN
			    IF(NOT ISBLANK(prev) && prev <> 0, ROUND(DIVIDE(cur - prev, prev) * 100, 1))
		formatString: 0.0\%;-0.0\%
		lineageTag: 16999ebb-23cf-45ec-89b2-e1e02e3f6a91

	measure 'Orders Change Pct' =
			VAR endDate  = MAX(orders_clean[order_purchase_timestamp])
			VAR backOff  = EDATE(endDate, -11)
			VAR curStart = DATE(YEAR(backOff), MONTH(backOff), 1)
			VAR prevEnd  = curStart - 1
			VAR backPre  = EDATE(prevEnd, -11)
			VAR prevStart = DATE(YEAR(backPre), MONTH(backPre), 1)
			VAR cur  = CALCULATE([Total Orders], DateTable[Date] >= curStart, DateTable[Date] <= endDate)
			VAR prev = CALCULATE([Total Orders], DateTable[Date] >= prevStart, DateTable[Date] <= prevEnd)
			RETURN
			    IF(NOT ISBLANK(prev) && prev <> 0, ROUND(DIVIDE(cur - prev, prev) * 100, 1))
		formatString: 0.0\%;-0.0\%
		lineageTag: 7c4f5a1e-9b2d-4e63-8f10-3a5d2c7b6e48

	measure 'AOV Change Pct' =
			VAR endDate  = MAX(orders_clean[order_purchase_timestamp])
			VAR backOff  = EDATE(endDate, -11)
			VAR curStart = DATE(YEAR(backOff), MONTH(backOff), 1)
			VAR prevEnd  = curStart - 1
			VAR backPre  = EDATE(prevEnd, -11)
			VAR prevStart = DATE(YEAR(backPre), MONTH(backPre), 1)
			VAR cur  = CALCULATE([Avg Order Value], DateTable[Date] >= curStart, DateTable[Date] <= endDate)
			VAR prev = CALCULATE([Avg Order Value], DateTable[Date] >= prevStart, DateTable[Date] <= prevEnd)
			RETURN
			    IF(NOT ISBLANK(prev) && prev <> 0, ROUND(DIVIDE(cur - prev, prev) * 100, 1))
		formatString: 0.0\%;-0.0\%
		lineageTag: 2d8e6c34-51a7-4b09-9e72-c4f183a95d61

	measure 'Freight Change Pct' =
			VAR endDate  = MAX(orders_clean[order_purchase_timestamp])
			VAR backOff  = EDATE(endDate, -11)
			VAR curStart = DATE(YEAR(backOff), MONTH(backOff), 1)
			VAR prevEnd  = curStart - 1
			VAR backPre  = EDATE(prevEnd, -11)
			VAR prevStart = DATE(YEAR(backPre), MONTH(backPre), 1)
			VAR cur  = CALCULATE([Total Freight], DateTable[Date] >= curStart, DateTable[Date] <= endDate)
			VAR prev = CALCULATE([Total Freight], DateTable[Date] >= prevStart, DateTable[Date] <= prevEnd)
			RETURN
			    IF(NOT ISBLANK(prev) && prev <> 0, ROUND(DIVIDE(cur - prev, prev) * 100, 1))
		formatString: 0.0\%;-0.0\%
		lineageTag: b6a1f0d2-3c74-4e58-8a91-5f2d7b4c0e93

